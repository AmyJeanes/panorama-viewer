{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pep723": {
    "managerFilePatterns": ["/^(tiles|examples/make)\\.py$/"]
  },
  "pinDigest": {
    "automerge": true
  }
}
